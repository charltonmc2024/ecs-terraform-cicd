# ==========================================

# Terraform

# ==========================================

# Local Terraform working directories

**/.terraform/*

# Terraform state files

*.tfstate
*.tfstate.*

# Terraform plan files

*.tfplan

# Terraform crash logs

crash.log
crash.*.log

# Terraform override files

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration

.terraformrc
terraform.rc

# NOTE:

# .terraform.lock.hcl is intentionally NOT ignored.

# It should be committed to Git.

# ==========================================

# Terraform Variables / Secrets

# ==========================================

# tfvars files may contain sensitive values

*.tfvars
*.tfvars.json
*.tfvars.example

# Allow sanitized example variable files

!*.tfvars.example

# ==========================================

# Environment Variables / Secrets

# ==========================================

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

# ==========================================

# AWS Credentials / Local AWS Configuration

# ==========================================

.aws/
credentials

# ==========================================

# Python Backend

# ==========================================

**pycache**/
*.py[cod]
*.pyo
*.pyd

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/

# ==========================================

# Node.js / React Frontend

# ==========================================

node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

dist/
build/

coverage/

# ==========================================

# Kiro

# ==========================================

# Keep project-level Kiro steering and skills in Git:

# .kiro/steering/

# .kiro/skills/

# Ignore local/user-specific Kiro files

.kiro/settings.local.json
.kiro/*.local

# ==========================================

# IDE / Editor

# ==========================================

.vscode/
.idea/

*.swp
*.swo
*~

# ==========================================

# Operating System

# ==========================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================

# Logs / Temporary Files

# ==========================================

*.log
*.tmp
*.temp
*.bak
