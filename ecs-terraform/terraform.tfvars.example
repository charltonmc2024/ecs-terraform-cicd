# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

app_name               = "eruditiontx-app"
vpc_name               = "ecs-vpc"
environment            = "ecs-dev"
aws_region             = "us-east-1"
domain_name            = "eruditionsys.com"

vpc_cidr               = "10.0.0.0/16"
public_subnet_cidr1    = "10.0.1.0/24"
public_subnet_cidr2    = "10.0.3.0/24"
private_subnet_cidr1   = "10.0.2.0/24"
private_subnet_cidr2   = "10.0.4.0/24"

ecs_task_cpu           = 512
ecs_task_memory        = 1024
container_port         = 80
ecs_desired_task_count = 1

# Leave empty to use the ECR repo's :latest tag (default).
# Set to a full image URI to pin a specific version, e.g.:
#   container_image = "123456789.dkr.ecr.us-east-1.amazonaws.com/eruditiontx-app-ecs-dev-repo:v1.0.0"
container_image        = ""
