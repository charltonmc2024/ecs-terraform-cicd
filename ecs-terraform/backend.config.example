# Copy this file to backend.config and fill in your values.
# backend.config is gitignored — never commit it.
#
# Used with: terraform init -backend-config=backend.config
#
# The bucket name is output by the bootstrap config:
#   cd bootstrap && terraform apply
# Format: <app_name>-<environment>-tfstate-<aws_account_id>

bucket       = "eruditiontx-app-ecs-dev-tfstate-<YOUR_AWS_ACCOUNT_ID>"
key          = "ecs-dev/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
