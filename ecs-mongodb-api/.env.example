# Copy to .env for LOCAL development only. .env is gitignored. Never commit real values.
#
# Read-only MongoDB connection string. MUST use a READ-ONLY Atlas user (NOT the
# readWrite import user). In ECS this is injected from AWS Secrets Manager, not a file.
MONGODB_URI=

# Logical database names (non-secret).
TEACHER_STUDENT_DB=teacher_student_db
ADMIN_STAFF_DB=admin_staff_mongodb

# API key for the x-api-key header. In ECS, injected from Secrets Manager.
# Placeholder only - set a real one locally via env, never commit it.
API_KEY=

# CORS allowlist (comma-separated). Empty disables CORS middleware. Never use a wildcard.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional URL path prefix for every route EXCEPT /health. Not a secret.
#   empty (default) : /ready, /schools, /users, /classes, /assignments (local Docker)
#   /v1             : /v1/ready, /v1/schools, ... (planned ECS value, behind CloudFront and
#                     the ALB). Unprefixed data routes are NOT served when a prefix is set.
# Must start with "/" and use letters, digits, ".", "_", "~", "-" in each segment.
# One trailing slash is removed. A malformed value stops the app at startup.
API_PREFIX=

# Port the app listens on.
PORT=8080
